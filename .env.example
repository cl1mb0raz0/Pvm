# Copy this file to .env and fill in real values before running
# docker compose up. Never commit the real .env file.

# At least 32 characters; PVM refuses to start with this example value.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,change-me-to-the-vm-hostname-or-ip

POSTGRES_DB=pvm
POSTGRES_USER=pvm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# CVSS scores from NVD. Leave the key empty to run without one (slower:
# 5 requests per 30 s); set NVD_ENABLED=false if the VM has no internet.
NVD_ENABLED=true
NVD_API_KEY=

# Fix status per Ubuntu release, for checking findings against installed
# packages. Set to false if the VM has no internet access.
UBUNTU_TRACKER_ENABLED=true
# Tracker requests made at the same time by one host check (the tracker is
# slow on records not asked for recently), and how long a CVE it failed to
# answer waits before an automatic check asks again ("Check Now" always does).
UBUNTU_TRACKER_WORKERS=8
UBUNTU_ERROR_RETRY_MINUTES=60

# Same, from Rocky Linux's own errata (RLSA advisories), for Rocky hosts.
ROCKY_TRACKER_ENABLED=true
ROCKY_TRACKER_WORKERS=8
ROCKY_ERROR_RETRY_MINUTES=60

# CISA Known Exploited Vulnerabilities catalog, downloaded nightly.
KEV_ENABLED=true

# EPSS (probability of exploitation) from FIRST, fetched nightly; used by
# the risk priority. Only CVE IDs are sent.
EPSS_ENABLED=true

# Package inventory over SSH ("Ask Server"). The secret encrypts Pvm's
# private SSH key in the database: set it before generating or uploading
# the key, and keep it (if it changes, the key must be created again).
# Generate it with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PVM_SSH_KEY_SECRET=
# The dedicated read-only account on each host, and the address Pvm
# connects from (goes into the suggested authorized_keys "from=" option).
PVM_SSH_USER=pvm-inventory
PVM_SSH_FROM=

# Where nginx listens: "8080" on every interface of the VM, or one address
# only, e.g. "127.0.0.1:8080" or "10.0.0.5:8080".
PVM_LISTEN=8080

# Set to true once nginx serves TLS (cookies then travel over HTTPS only).
DJANGO_HTTPS=false

# Sign-in: sessions end after this many hours without activity; after the
# given failed password attempts within the lockout window (per username,
# per IP), sign-in is refused until the window passes.
PVM_SESSION_IDLE_HOURS=8
PVM_LOGIN_LOCKOUT_MINUTES=15
PVM_LOGIN_MAX_FAILURES_PER_USER=5
PVM_LOGIN_MAX_FAILURES_PER_IP=20

# Qualys API: VMDR (scans, KnowledgeBase) and the gateway (CSAM). The URLs
# depend on the platform (see the address of the Qualys web login; EU2:
# qualysguard.qg2.apps.qualys.eu). Use a dedicated read-only API user.
# A password containing $ must be written in single quotes:
# QUALYS_PASSWORD='pa$$word' (Docker Compose would otherwise expand it).
QUALYS_API_URL=https://qualysapi.qg2.apps.qualys.eu
QUALYS_GATEWAY_URL=https://gateway.qg2.apps.qualys.eu
QUALYS_USERNAME=
QUALYS_PASSWORD=
# How far back the Qualys Scans tab lists scans by default (days), and the
# time zone of automatic-import rules ("every Monday at 08:00").
QUALYS_SCAN_LIST_DAYS=90
# Scans never listed nor imported: titles starting with these (comma-separated).
QUALYS_EXCLUDED_TITLE_PREFIXES=connector-cps
PVM_SCHEDULE_TIME_ZONE=Europe/Rome

# Time zone of every date and time Pvm shows, of "today" and of the nightly
# jobs (NVD 03:00, KEV 03:30, EPSS 03:45, re-check 04:00, priority 04:30,
# snapshot 05:00). The automatic-import rules follow PVM_SCHEDULE_TIME_ZONE,
# which defaults to this one.
PVM_TIME_ZONE=Europe/Rome

# User and group the database container runs as (the owner of ./data). The
# project folder may sit on a filesystem that refuses chown, so Postgres
# cannot switch to its own user. Check with `id -u` / `id -g`.
PVM_UID=1000
PVM_GID=1000
